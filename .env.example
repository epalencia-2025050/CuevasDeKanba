# Documentation only: inject variables through the server or secret manager.
# Never commit real values. Locally you may copy this file as `.env` and run
# `npm run start:local` / `npm run dev:local` (both load .env with --env-file).
NODE_ENV=production
ADMIN_PASSWORD=
DATABASE_URL=
PGSSLMODE=verify-full
# Optional: choose inline CA PEM OR its file path, never both.
PG_TLS_CA=
PG_TLS_CA_FILE=
PG_TLS_SERVERNAME=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_TLS_CA=
SMTP_TLS_CA_FILE=
SMTP_TLS_SERVERNAME=
# These variables do NOT enable real payments or webhooks.
PAYMENTS_SECRET_KEY=
PAYMENTS_WEBHOOK_SECRET=

# Required for production: exact public HTTPS origin, and ONLY actual proxy networks.
PUBLIC_URL=
TRUSTED_PROXY_CIDRS=
DB_SCHEMA=kanba
# Postfix submission: use the mode/port configured by your administrator.
# SMTP_SECURE=true means implicit TLS; false means mandatory STARTTLS.
# Legacy admin bootstrap only: set to 1 for one controlled restart, then unset.
FORCE_ADMIN_PASSWORD=0

# Inicio de sesión con Google (OAuth 2.0).
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-tu-secreto
# Opcional: solo si usas un dominio propio o un proxy distinto.
# Por defecto se detecta desde la petición: https://TU-DOMINIO/api/auth/google/callback
# GOOGLE_REDIRECT_URI=https://tu-dominio.com/api/auth/google/callback
