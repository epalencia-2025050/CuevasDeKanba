# Documentation only: inject variables through the server or secret manager.
# Never commit real values. Locally you may copy this file as `.env` and run
# `npm run start:local` / `npm run dev:local` (both load .env with --env-file).
NODE_ENV=production
ADMIN_PASSWORD=
DATABASE_URL=
# Direct PostgreSQL always verifies TLS. Node supports a custom inline CA.
PG_TLS_CA=
PG_TLS_SERVERNAME=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_TLS_CA=
SMTP_TLS_CA_FILE=
SMTP_TLS_SERVERNAME=
# Stripe Checkout (cuenta comercial habilitada). PAYMENTS_PROVIDER=stripe.
# En producción usa una clave live y el secreto de firma del endpoint HTTPS
# POST /api/webhooks/payments. Suscribe checkout.session.completed,
# checkout.session.expired, checkout.session.async_payment_failed y payment_intent.payment_failed.
# Monedas habilitadas por este adaptador: GTQ, USD, EUR.
PAYMENTS_PROVIDER=
PAYMENTS_SECRET_KEY=
PAYMENTS_WEBHOOK_SECRET=

# Required for production: exact public HTTPS origin, and ONLY actual proxy networks.
PUBLIC_URL=
TRUSTED_PROXY_CIDRS=
DB_SCHEMA=kanba_rel
# Postfix submission: use the mode/port configured by your administrator.
# SMTP_SECURE=true means implicit TLS; false means mandatory STARTTLS.
# ADMIN_PASSWORD is used by db:init / db:rotate-admin, never rotated on startup.

# Portable mail gateway (HTTPS). Required for real delivery in Workers;
# optional in Node, which can instead use the SMTP adapter above.
# Resend: MAIL_API_URL=https://api.resend.com/emails, MAIL_API_TOKEN=API key.
# SMTP_FROM debe ser un remitente verificado. Worker requiere cron activo.
MAIL_API_URL=
MAIL_API_TOKEN=

# Inicio de sesión con Google (OAuth 2.0).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to PUBLIC_URL + /api/auth/google/callback, never a request header.
# GOOGLE_REDIRECT_URI=https://tu-dominio.com/api/auth/google/callback
