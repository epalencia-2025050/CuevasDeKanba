{
  "name": "cuevasdekanba",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sitio web y sistema de reservas para las Cuevas de K'anba, Lanquín, Alta Verapaz, Guatemala.",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "build:worker": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "deploy:worker": "wrangler deploy",
    "preview": "wrangler deploy --dry-run",
    "dev": "node --watch server/node.js",
    "dev:worker": "wrangler dev",
    "dev:local": "node --env-file=.env --watch server/node.js",
    "start": "node server/node.js",
    "start:local": "node --env-file=.env server/node.js",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "test:p0": "node --experimental-vm-modules --test tests/p0-security.test.mjs",
    "release:source": "node scripts/package-release.mjs",
    "db:init": "node --env-file=.env scripts/initialize-database.mjs",
    "db:relational": "node --env-file=.env scripts/apply-neon-relational.mjs",
    "db:rotate-admin": "node --env-file=.env scripts/rotate-admin.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261117.0-beta",
    "wrangler": "^4.164.0"
  }
}
